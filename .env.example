# Copy to .env and fill in. Keys are case-insensitive. Never commit .env.

# --- Required -------------------------------------------------------------------------------
# Gemini API key (https://aistudio.google.com): answers, embeddings, voice, translation, studio
GEMINI_API_KEY=your-key-from-aistudio.google.com

# --- S3 cold tier (only needed to build the archive: scripts/archive_s3.py) -------------------
# S3-compatible bucket used by MariaDB's S3 storage engine (docker-compose passes these to MariaDB)
access_key=
secret_key=
# S3_HOST=s3.ironshard.ai
# S3_BUCKET=wikipilot
# S3_REGION=auto

# --- Optional overrides (defaults shown) ------------------------------------------------------
# GEMINI_MODEL=gemini-3.5-flash            # answers, drift, lens, studio, war analysis
# GEMINI_THINKING=0                        # thinking-token budget; 0 = off (fastest, ~7x), empty = model default
# GEMINI_FAST_MODEL=gemini-3.5-flash       # planning, translation, blame story, image prompts
# GEMINI_EMBED_MODEL=gemini-embedding-2    # must match the model that built the passages (table `meta`)
# GEMINI_STT_MODEL=gemini-3.5-flash        # voice input
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts    # listen
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# DB_HOST=127.0.0.1
# DB_PORT=3309
# PORT=8765                                # WikiPilot web server
# MIN_FREE_GB=3                            # long data jobs pause below this much free disk
